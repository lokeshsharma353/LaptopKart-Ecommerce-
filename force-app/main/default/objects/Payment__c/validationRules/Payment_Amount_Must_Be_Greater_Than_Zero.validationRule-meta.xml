<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Payment_Amount_Must_Be_Greater_Than_Zero</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
    ISBLANK(Amount__c),
    Amount__c &lt;= 0
)</errorConditionFormula>
    <errorMessage>Payment Amount must be greater than 0.</errorMessage>
</ValidationRule>
