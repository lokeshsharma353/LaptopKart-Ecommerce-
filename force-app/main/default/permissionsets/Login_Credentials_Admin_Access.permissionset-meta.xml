<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Login Credentials Admin Access</label>
    <description>FLS on Login_Credentials__c.Password_Text__c and Cart_Items__c so admins can view/edit these in Setup/record pages (the storefront's own Apex uses SYSTEM_MODE, so it doesn't need this).</description>
    <fieldPermissions>
        <field>Login_Credentials__c.Password_Text__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Login_Credentials__c.Cart_Items__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Cart_Activity__c.Product_Name__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Cart_Activity__c.Quantity__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Cart_Activity__c.Price__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <objectPermissions>
        <object>Login_Credentials__c</object>
        <allowRead>true</allowRead>
        <allowCreate>true</allowCreate>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>true</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Cart_Activity__c</object>
        <allowRead>true</allowRead>
        <allowCreate>true</allowCreate>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>true</modifyAllRecords>
    </objectPermissions>
    <tabSettings>
        <tab>Cart_Activity__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <hasActivationRequired>false</hasActivationRequired>
</PermissionSet>
