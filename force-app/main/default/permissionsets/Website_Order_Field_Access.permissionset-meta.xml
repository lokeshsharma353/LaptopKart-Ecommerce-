    <!-- Stock_Movement__c — Movement_Type__c/Quantity__c are required and
         cannot carry an explicit FLS entry (Salesforce always grants
         required fields read/edit and rejects the redundant grant).
         Product__c is NOT schema-required (see its own field description
         for why) so it needs one, same as any other optional field. -->
    <fieldPermissions>
        <field>Stock_Movement__c.Product__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
