    <!-- Salesforce enforces object-level CRUD permissions strictly for Guest
         Users regardless of Apex sharing mode (unlike regular authenticated
         users, where without-sharing Apex normally bypasses this) — every
         object the checkout pipeline creates or updates needs an explicit
         grant here, or the DML throws System.SecurityException. -->
    <objectPermissions>
        <object>Lead</object>
        <allowCreate>true</allowCreate>
